# Event store. Defaults to a local SQLite file; use Postgres in production (postgres:// URLs are accepted).
DATABASE_URL="postgresql://churnwise:churnwise@localhost:5432/churnwise"

# Shared secret used to sign billing webhooks (HMAC-SHA256 of "<timestamp>.<raw body>")
BILLING_WEBHOOK_SECRET="whsec_replace_me"

# Bearer token for the /api/workspaces/* endpoints. Leave unset only for local development.
API_TOKEN=""

# Comma-separated browser origins allowed to call the API directly (the web app calls it server-side).
CORS_ORIGINS=""
